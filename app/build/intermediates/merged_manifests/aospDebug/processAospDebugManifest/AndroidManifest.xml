<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.thenile.vault"
    android:versionCode="2"
    android:versionName="1.1" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Shizuku's own runtime permission on API 34+; pre-34 it grants via its manager app dialog. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!--
         Root's file hiding runs entirely via a root shell, which bypasses scoped storage — no
         permission needed there. SoftVault (Shizuku/no-root) runs plain java.io.File calls inside
         Nile's own process, which scoped storage silently blocks for directories/files the app
         didn't create itself (confirmed on-device: hide silently no-ops, no error). This is the
         broad "All files access" grant instead of per-directory SAF trees — see SoftVault.kt.
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Re-arms the dead man's switch alarm after reboot (AlarmManager alarms don't survive one). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
         Vault Accounts: list + remove device accounts. Doesn't grant visibility into accounts the
         owner hasn't shared with Nile (Android 8+) — see AccountPickerDialog.
    -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <!-- Device Tamper Lockdown: SIM-change detection reads the SIM serial number. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!--
         Geofence Lockdown: the safe-zone proximity alert. Background location is what lets the
         alert still fire when Nile isn't open — without it the geofence only works in-app.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" /> <!-- suppress DeprecatedClassUsageInspection -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <permission
        android:name="com.thenile.vault.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.thenile.vault.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TheNile"
        android:windowSoftInputMode="adjustResize" >
        <provider
            android:name="com.thenile.vault.AppContextProvider"
            android:authorities="com.thenile.vault.appctx"
            android:exported="false" />

        <!--
             Lets the Shizuku app/manager bind to request+relay shell-UID privileges when this
             device has no root (e.g. GrapheneOS) but does have Shizuku running via ADB/wireless
             debugging. Standard rikka.shizuku-api boilerplate, values as documented upstream.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.thenile.vault.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name="com.thenile.vault.ui.PromptActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" >
        </activity>
        <activity
            android:name="com.thenile.vault.ui.AdminActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.TheNile" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
 Injects a "The Nile" tile into the AOSP Settings app under System. Only appears when
             Nile is installed on the system image (priv-app) — AOSP's SettingsLib ignores injected
             tiles from non-system apps, so this is inert for a normal APK install. A true top-level
             Evolver-style dashboard entry needs a Settings source fork; this reuses AdminActivity.
        -->
        <activity-alias
            android:name="com.thenile.vault.ui.NileSettingsTile"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="The Nile"
            android:targetActivity="com.thenile.vault.ui.AdminActivity" >
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>

            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.title"
                android:value="The Nile" />
            <meta-data
                android:name="com.android.settings.summary"
                android:value="Vault, decoy switching &amp; anti-forensics" />
        </activity-alias>
        <!--
 Separate alias (not a second intent-filter on AdminActivity itself) so the
             "Browser Deep Link" toggle can disable just this entry point via
             setComponentEnabledSetting without touching the launcher entry.
        -->
        <activity-alias
            android:name="com.thenile.vault.ui.AdminActivityDeepLink"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="com.thenile.vault.ui.AdminActivity" >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="admin"
                    android:scheme="nile" />
                <data
                    android:host="open"
                    android:scheme="nile" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="com.thenile.vault.services.NileTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="The Nile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" >
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name="com.thenile.vault.services.NileAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name="com.thenile.vault.receivers.SecretCodeReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />

                <data android:scheme="android_secret_code" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />

                <data
                    android:host="1234"
                    android:scheme="android_secret_code" />
                <data
                    android:host="8888"
                    android:scheme="android_secret_code" />
                <data
                    android:host="9876"
                    android:scheme="android_secret_code" />
                <data
                    android:host="1111"
                    android:scheme="android_secret_code" />
                <data
                    android:host="3333"
                    android:scheme="android_secret_code" />
            </intent-filter>
        </receiver>

        <!--
             Real-lockscreen decoy trigger for the AOSP edition. Fired by a ROM's patched Keyguard,
             not by any app: the signature|privileged permission means only the platform (same
             signer) or a priv-app can deliver it, so a normal app can't spoof a decoy trigger.
             Inert unless the ROM is patched to send it.
        -->
        <receiver
            android:name="com.thenile.vault.receivers.LockscreenDecoyReceiver"
            android:exported="true"
            android:permission="android.permission.MANAGE_USERS" >
            <intent-filter>
                <action android:name="com.thenile.vault.action.LOCKSCREEN_DECOY" />
            </intent-filter>
        </receiver>

        <!--
             Dead man's switch: periodic check (armed by DeadManSwitch.reschedule) plus a re-arm on
             boot, since AlarmManager alarms don't survive a reboot. Not exported to other apps —
             android:exported is left implicit-false, but BOOT_COMPLETED still requires the system
             be able to deliver it, which it can regardless.
        -->
        <receiver
            android:name="com.thenile.vault.receivers.DeadManSwitchReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.thenile.vault.action.DEAD_MAN_SWITCH_CHECK" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.thenile.vault.receivers.ScheduledLockReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.thenile.vault.action.SCHEDULED_LOCK_CHECK" />
            </intent-filter>
        </receiver>

        <!--
             The screen-off delay alarm. SCREEN_OFF/SCREEN_ON themselves can't be declared in a
             manifest at all — ScreenReceiver handles those, registered in AppContextProvider.
        -->
        <receiver
            android:name="com.thenile.vault.receivers.ScreenOffCheckReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="com.thenile.vault.action.SCREEN_OFF_CHECK" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.thenile.vault.receivers.GeofenceReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.thenile.vault.action.GEOFENCE_PROXIMITY" />
            </intent-filter>
        </receiver>

        <!--
             UsbPluggedSwitch's trigger source (UsbPluggedReceiver) is registered dynamically in
             AppContextProvider instead of here: ACTION_POWER_CONNECTED is NOT in Android 8+'s
             implicit-broadcast exemption list, so a manifest receiver for it is silently skipped
             ("Background execution not allowed") whenever the app isn't already running —
             confirmed on-device.
        -->


        <!--
             WrongPinSwitch's trigger source: onPasswordFailed()/onPasswordSucceeded() only fire
             for an active device admin, granted by the user via the button in Admin > Security &
             Auth (Settings.ACTION_ADD_DEVICE_ADMIN) — inert until then. android:permission is
             required by the platform for every device admin receiver.
        -->
        <receiver
            android:name="com.thenile.vault.receivers.NileDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN" >
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false" />
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false" />

        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            android:exported="true" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.thenile.vault.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>