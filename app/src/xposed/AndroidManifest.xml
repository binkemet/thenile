<?xml version="1.0" encoding="utf-8"?>
<!-- Xposed-flavor-only manifest additions. Merged into the base manifest for the `xposed` build
     variant; the `aosp` variant never sees these, so a ROM-baked Nile does not advertise itself as
     an Xposed/LSPosed module and carries no hook entry point. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="The Nile Stealth Engine" />
        <meta-data
            android:name="xposedminversion"
            android:value="100" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
        <meta-data
            android:name="xposedentrypoint"
            android:value="com.thenile.vault.xposed.PackageManagerHook" />
    </application>
</manifest>
